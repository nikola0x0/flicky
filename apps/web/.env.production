# apps/web — production build env (loaded by `vite build`). All values are
# client-public (Vite inlines VITE_* into the bundle): public Enoki key,
# OAuth client id, on-chain package/oracle ids, and the Railway backend URL.
# No secrets here. Override per-deploy with Railway build variables if needed.

# Flicky backend (apps/server) on Railway — sponsored gas + Deckmaster + WS.
VITE_SERVER_HTTP_URL=https://flicky-server-production.up.railway.app
VITE_SERVER_WS_URL=wss://flicky-server-production.up.railway.app/ws
VITE_SPONSOR_URL=https://flicky-server-production.up.railway.app
VITE_DECKMASTER_URL=https://flicky-server-production.up.railway.app

# DEFAULT Sui network — used when the player hasn't picked one via
# the header chip yet. Switching is per-browser (localStorage).
VITE_SUI_NETWORK=testnet

# Flicky package (testnet) — matches apps/contracts/deployed.json.
VITE_FLICKY_PACKAGE_ID_TESTNET=0x5ceae1cacbba1862e0f0c4e8861280b8a1e9530ce4049317daf5d3951778582f

# DeepBook Predict 6-24 (testnet). Package + shared objects + BTC oracle feeds.
# (4-16's single `Predict` object + `OracleSVI` are gone in 6-24.)
VITE_DEEPBOOK_PREDICT_PACKAGE_ID=0xdb3ef5a5129920e59c9b2ae25a77eddb48acd0e1c6307b97073f0e076016446e
VITE_DEEPBOOK_PROTOCOL_CONFIG_ID=0x2325224629b4bd96d1f1d7ee937e07f8a06f861018a130bbb26db09cb0394cb6
VITE_DEEPBOOK_POOL_VAULT_ID=0xfde98c636eb8a7aba59c3a238cfee6b576b7118d1e5ffa2952876c4b270a3a2a
VITE_DEEPBOOK_PREDICT_REGISTRY_ID=0x54afbf245caf42466cedb5756ed7816f34f544afdfa13579a862eccf3afa21ca
VITE_DEEPBOOK_ACCOUNT_PACKAGE_ID=0xb9389eac8d59170ffd1427c1a66e5c8306263464fcc6615e825c1f5b3e15da3b
VITE_DEEPBOOK_ACCOUNT_REGISTRY_ID=0x3c54d5b8b6bca376fc289121838ad02f8a5b3843242b9ad7e8f8245720e685a2
VITE_DEEPBOOK_ORACLE_REGISTRY_ID=0xf3deaff68cbd081a35ec21653af6f671d2ad5f012f3b4d817d81752843374136
VITE_DEEPBOOK_PYTH_FEED_ID=0xc78d7de16217d46d21b92ae475da799448be30b71a758dc6d7bb3ac2f1c35afb
VITE_DEEPBOOK_BS_SPOT_FEED_ID=0xcdc5fa7364e60fd2504aa96f65b707dc0734e507a919b1a7d7d63164fd67b745
VITE_DEEPBOOK_BS_FORWARD_FEED_ID=0xe72c734ea8d8dcbc9183d9d8f96f51aaa1fb5034d5ed33ac60d67d261e15b48a
VITE_DEEPBOOK_BS_SVI_FEED_ID=0xdc2f8270676bd05fb28491e8d4a41a495722fda7a454926dd66dbba256a21c69
VITE_DEEPBOOK_ACCUMULATOR_ROOT_ID=0xacc
VITE_DEEPBOOK_PREDICT_INDEXER_URL=https://predict-server-beta.testnet.mystenlabs.com

# dUSDC + SUI coin types.
VITE_DUSDC_COIN_TYPE=0xe95040085976bfd54a1a07225cd46c8a2b4e8e2b6732f140a0fc49850ba73e1a::dusdc::DUSDC
VITE_SUI_COIN_TYPE=0x2::sui::SUI

# SUI ↔ dUSDC AMM swap (testnet deployment).
VITE_SWAP_PACKAGE_ID=0x51ea0f29321f3c25f8b2f530ecd3ed3dec569d954c8832d318de7e203653a936
VITE_SWAP_POOL_ID=0x778c0b0570a541ec38463a9e2f1596e25777570a466da0ba1796bdbe2846bdcd

# Enoki zkLogin — PUBLIC key (safe in client bundle).
VITE_ENOKI_API_KEY=enoki_public_8170d7cff8a4c5bce48ecf73bf97f135
# Google OAuth client id (public). Add the Railway web origin to the allowed
# JavaScript origins + redirect URIs in the Google console.
VITE_GOOGLE_CLIENT_ID=1015826420777-n3r8v2che355oiucuvocpmph6vmhgeb4.apps.googleusercontent.com

# =============================================================================
# MAINNET (network switcher)
# =============================================================================
# The app serves both chains from one build. Testnet is the default; the game
# header has a chip that switches to mainnet (persists + reloads).
#
# Convention: VITE_FOO = testnet, VITE_FOO_MAINNET = mainnet. There is no
# _PROD suffix. Mainnet NEVER falls back to a testnet value — a wrong package
# id on mainnet is how you sponsor a transaction against the wrong chain.
#
# Everything below is EMPTY on purpose. DeepBook Predict has no mainnet
# deployment yet (testnet-only; mainnet slated for later in 2026), so mainnet
# is a gated preview: wallet + balances + profile work, and the duel routes
# render <NetworkGate />. Filling in the two Predict/flicky ids is what turns
# the gate off. See docs/network-switching.md for the full flip checklist.

# Which networks the header chip offers. Set to "testnet" to hide the chip.
VITE_SUI_NETWORKS=testnet,mainnet

# Flicky package on mainnet — written by
# `SUI_NETWORK=mainnet bun --filter @flicky/contracts publish`.
VITE_FLICKY_PACKAGE_ID_MAINNET=

# DeepBook Predict on mainnet. Not deployed yet — leave unset until it is.
VITE_DEEPBOOK_PREDICT_PACKAGE_ID_MAINNET=
VITE_DEEPBOOK_PROTOCOL_CONFIG_ID_MAINNET=
VITE_DEEPBOOK_POOL_VAULT_ID_MAINNET=
VITE_DEEPBOOK_PREDICT_REGISTRY_ID_MAINNET=
VITE_DEEPBOOK_ACCOUNT_PACKAGE_ID_MAINNET=
VITE_DEEPBOOK_ACCOUNT_REGISTRY_ID_MAINNET=
VITE_DEEPBOOK_ORACLE_REGISTRY_ID_MAINNET=
VITE_DEEPBOOK_PYTH_FEED_ID_MAINNET=
VITE_DEEPBOOK_BS_SPOT_FEED_ID_MAINNET=
VITE_DEEPBOOK_BS_FORWARD_FEED_ID_MAINNET=
VITE_DEEPBOOK_BS_SVI_FEED_ID_MAINNET=
VITE_DEEPBOOK_ACCUMULATOR_ROOT_ID_MAINNET=
VITE_DEEPBOOK_PREDICT_INDEXER_URL_MAINNET=

# Stake coin on mainnet — native USDC, NOT dUSDC (that's a testnet faucet
# token). Fill in at flip time.
VITE_DUSDC_COIN_TYPE_MAINNET=

# SUI <-> USDC AMM on mainnet (publish apps/contracts/swap there first).
VITE_SWAP_PACKAGE_ID_MAINNET=
VITE_SWAP_POOL_ID_MAINNET=

# Sui node endpoints. Both default to the public mainnet fullnode, so these
# are only needed for a private RPC.
VITE_SUI_GRPC_URL_MAINNET=
VITE_SUI_GRAPHQL_URL_MAINNET=

# Optional: mainnet sponsor address override (skips the GET /sponsor
# round-trip). Must be the MAINNET sponsor — never reuse the testnet one.
VITE_SPONSOR_ADDRESS_MAINNET=
